# ── Contact form (required in production) ─────────────────────────────
# Create a key at https://resend.com/api-keys (sign up with varunpadala137@gmail.com)
RESEND_API_KEY=
# Where contact-form messages are delivered
CONTACT_TO_EMAIL=varunpadala137@gmail.com

# ── Optional ──────────────────────────────────────────────────────────
# Custom sender once you verify your own domain in Resend
# CONTACT_FROM_EMAIL=Portfolio <hello@your-domain.com>

# Raises the GitHub API rate limit (a fine-grained token with no permissions is enough)
# GITHUB_TOKEN=

# Canonical URL for SEO / social previews (Vercel sets a default automatically)
# NEXT_PUBLIC_SITE_URL=https://your-domain.com
